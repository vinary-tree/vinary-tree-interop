use Test;
use NativeCall;
use lib 'lib';
use Vinary::Tree::Interop;

sub test-library(--> Str:D) { %*ENV<VINARY_TREE_INTEROP_TEST_LIB> }
sub vt_test_resource(RawResource) is native(&test-library) { * }
sub vt_test_references(--> size_t) is native(&test-library) { * }

plan 59;

my $raw = RawResource.new;
vt_test_resource($raw);
is vt_test_references(), 1, 'fixture returns one owned reference';

my $resource = adopt-resource($raw);
ok $resource.opened, 'adopted resource is open';
my $retained = $resource.retain;
is vt_test_references(), 2, 'retain duplicates ownership';
$retained.close;
is vt_test_references(), 1, 'close releases retained ownership';

my $dictionary = dictionary($resource, :take);
is $dictionary.unit-domain, UNICODE-SCALAR, 'unit domain is modeled';
is $dictionary.value-domain, OPTIONAL-U64, 'value domain is modeled';
is $dictionary.known-length, 2, 'known length is returned';
is $dictionary.root, 0, 'root node is returned';
ok !$dictionary.is-final(0), 'root is not final';
ok $dictionary.is-final(1), 'terminal node is final';
is $dictionary.value(1), 10, 'optional u64 value is returned';
ok $dictionary.value(0) === UInt, 'missing value is represented by the UInt type object';
is $dictionary.transition(0, 'a'.ord), 1, 'transition returns child';
ok $dictionary.transition(0, 'x'.ord) === UInt,
    'missing transition is represented by the UInt type object';
ok $dictionary{'a'}:exists, 'dictionary implements Associative existence';
nok $dictionary{'x'}:exists, 'Associative existence rejects absent keys';
is $dictionary{'a'}, 10, 'Associative lookup returns the stored value';
is $dictionary.elems, 2, 'Associative cardinality uses exact metadata';
my @edges = $dictionary.edges(0, batch-size => 1);
is @edges.elems, 2, 'edge paging returns every edge';
is @edges[0].label, 'a'.ord, 'first edge label is preserved';
is @edges[1].node, 2, 'second edge target is preserved';
my @parallel = await (^32).map: { start { $dictionary.transition(0, 'a'.ord) } };
is-deeply @parallel, [1 xx 32],
    'parallel-reentrant providers support concurrent NativeCall reads';
my $snapshot = $dictionary.snapshot;
is vt_test_references(), 2, 'snapshot owns an independent resource reference';
$snapshot.close;
is vt_test_references(), 1, 'snapshot close releases its reference';
my $entries = entries($dictionary);
is vt_test_references(), 2, 'entry cursor retains its snapshot resource';
is $entries.known-length, 2, 'entry metadata includes exact length';
is $entries.unit-domain, UNICODE-SCALAR, 'entry unit domain is modeled';
is $entries.value-domain, OPTIONAL-U64, 'entry value domain is modeled';
is $entries.order, LEXICOGRAPHIC, 'entry ordering is modeled';
is $entries.snapshot-identity.producer, 42, 'entry snapshot producer is preserved';
is $entries.snapshot-identity.revision, 7, 'entry snapshot revision is preserved';
my $first-batch = $entries.next-batch;
is-deeply $first-batch.entries[0].units, ['a'.ord],
    'bounded entry batch copies Unicode scalar units';
is $first-batch.entries[0].value, 10, 'bounded entry batch copies values';
$first-batch.release;
my $second-batch = $entries.next-batch;
$second-batch.release;
ok !$entries.next-batch.defined, 'entry cursor reports end explicitly';
$entries.close;
is vt_test_references(), 1, 'entry cursor close releases its resource';
my @iterated = entries($dictionary).list;
is-deeply @iterated.map(*.units).Array, [['a'.ord], ['b'.ord]],
    'entry cursor implements bounded Iterable traversal';
is vt_test_references(), 1, 'completed iteration closes its cursor resource';
my $reduction = entries($dictionary);
my @reduced;
my $reduced-count = $reduction.reduce(
    -> @page { @reduced.append(@page) },
    BatchLimits.new(max-entries => 1, max-units => 1, max-values => 1),
);
is $reduced-count, 2, 'native reducer returns its exact processed count';
is-deeply @reduced.map(*.value).Array, [10, 20],
    'native reducer callbacks preserve every value';
$reduction.close;
is vt_test_references(), 1, 'reducer cursor close releases its resource';
my $failing-reduction = entries($dictionary);
throws-like {
    $failing-reduction.reduce(-> @page { die 'intentional reducer failure' });
}, X::AdHoc, message => /'intentional reducer failure'/,
    'reducer callbacks contain and rethrow language exceptions';
$failing-reduction.close;
is vt_test_references(), 1, 'failed reducer cursor remains deterministically closable';
$dictionary.close;
is vt_test_references(), 0, 'dictionary close releases adopted ownership';

my $wfst-raw = RawResource.new;
vt_test_resource($wfst-raw);
is vt_test_references(), 1, 'WFST fixture returns one owned reference';
my $wfst = wfst(adopt-resource($wfst-raw), :take);
is $wfst.unit-domain, UNICODE-SCALAR, 'WFST unit domain is modeled';
is $wfst.weight-domain, TROPICAL-F64, 'WFST weight domain is modeled';
is $wfst.start, 0, 'WFST start state is returned';
is $wfst.state-count, 2, 'WFST known state count is returned';
ok $wfst.state-info(1).final, 'WFST finality is returned';
is $wfst.state-info(1).final-weight, 2e0, 'WFST final weight is returned';
ok $wfst.state-info(9) === StateInfo,
    'invalid WFST state uses the StateInfo type object';
my @arcs = $wfst.arcs(0, batch-size => 1);
is @arcs.elems, 1, 'WFST arc paging returns every arc';
is @arcs[0].input, 'a'.ord, 'WFST input label is preserved';
is @arcs[0].output, 'A'.ord, 'WFST output label is preserved';
is @arcs[0].target, 1, 'WFST target is preserved';
is @arcs[0].weight, 1.5e0, 'WFST weight is preserved';
my $wfst-snapshot = $wfst.snapshot;
is vt_test_references(), 2, 'WFST snapshot retains an independent resource';
$wfst-snapshot.close;
is vt_test_references(), 1, 'WFST snapshot close releases its reference';
$wfst.close;
is vt_test_references(), 0, 'WFST close releases adopted ownership';
