cabal-version: 3.0
name: vinary-tree-interop
version: 4.0.0
x-release-candidate: rc.6
synopsis: Share live dictionaries and weighted automata safely across languages
description: A stable, dependency-free resource ABI for sharing live dictionaries, weighted automata, and host-defined algebra safely across Vinary Tree libraries and languages.
category: FFI
license: Apache-2.0
author: Dylon Edwards
maintainer: dylon.devo@gmail.com
build-type: Simple

library
  exposed-modules: VinaryTree.Interop
  hs-source-dirs: src
  c-sources: cbits/resource.c
  include-dirs: include
  includes: vinary_tree_interop.h
  install-includes: vinary_tree_interop.h
  default-language: GHC2021
  build-depends: base >=4.18 && <5
